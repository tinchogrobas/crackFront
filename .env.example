NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=dz1a6pzhf
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=users_uploads

# ─── SEO ─────────────────────────────────────────────────────────────────────
# Dominio canónico. Sin esto los sitemaps, los canonical y los feeds apuntan al
# dominio de preview de Vercel y Google indexa el sitio equivocado.
NEXT_PUBLIC_SITE_URL=https://cracktcg.com
# Search Console → Propiedad de prefijo de URL → Etiqueta HTML (solo el content).
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# ─── Medición ────────────────────────────────────────────────────────────────
# Todo opcional: sin ID no se carga el script. Se puede usar GTM solo, tags
# directos solos, o los dos (la capa de eventos empuja al dataLayer igual).
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_GOOGLE_ADS_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# Etiquetas de conversión de Google Ads (Objetivos → Conversiones → Configurar
# con etiqueta). Solo la parte después de la barra: AW-123/AbC-D_efGh12345 → AbC-D_efGh12345
NEXT_PUBLIC_ADS_LABEL_PURCHASE=
NEXT_PUBLIC_ADS_LABEL_BEGIN_CHECKOUT=
NEXT_PUBLIC_ADS_LABEL_ADD_TO_CART=
NEXT_PUBLIC_ADS_LABEL_LEAD=

# Conversions API de Meta (server-side). El token NO lleva NEXT_PUBLIC_:
# se expondría en el bundle del browser y cualquiera podría escribir en el pixel.
NEXT_PUBLIC_META_CAPI_ENABLED=false
META_CAPI_ACCESS_TOKEN=
# Solo para probar en Events Manager → Probar eventos. Vaciar en producción.
META_CAPI_TEST_EVENT_CODE=

# Banner de cookies. Consent Mode v2 funciona igual sin él (defaults por región).
NEXT_PUBLIC_CONSENT_BANNER=true

# ─── Feeds de shopping ───────────────────────────────────────────────────────
# Tarifa de envío para el schema de producto y el feed de Merchant Center.
# En 0 se omite el bloque y mandan las reglas de envío de la cuenta de Merchant
# Center, que es donde conviene tenerlas porque varían por zona y método.
NEXT_PUBLIC_FEED_SHIPPING_ARS=0

# ─── Cuentas de clientes (Supabase Auth) ─────────────────────────────────────
# Supabase → Project Settings → API. La clave es la PÚBLICA (sb_publishable_…
# o la "anon"); nunca la secret/service_role. Sin estas dos, las cuentas se
# apagan solas y el sitio vende igual.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxx
